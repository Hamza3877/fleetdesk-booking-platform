# Copy this file to .env.local to change the defaults. The app runs fine without it.

# --- Database (optional) ---------------------------------------------------------------
# Without DATABASE_URL the app uses demo data in memory (resets on restart).
# With it, everything is stored in PostgreSQL. On Supabase: Project Settings -> Database ->
# Connection string -> "Transaction pooler" (port 6543), then replace [YOUR-PASSWORD].
# The app creates its tables and loads demo data by itself on the first request.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres
# To try database mode locally instead: run `npm run db:local` in another terminal, then use
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Owner login for the dashboard (these are also the demo credentials shown on /login)
OWNER_EMAIL=owner@fleetdesk.dev
OWNER_PASSWORD=demo1234

# Used to sign the login cookie. Set a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the site (used for Stripe redirects, sitemap and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: add a Stripe TEST secret key (sk_test_...) to switch from the built-in
# test checkout page to real Stripe Checkout in test mode.
# STRIPE_SECRET_KEY=sk_test_...
